# ─── Base de datos ───────────────────────────────────────────────
# Con `docker compose up -d` la base queda disponible en esta URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gymwarrior"

# ─── Autenticación (Better Auth) ─────────────────────────────────
# Genera uno con: openssl rand -base64 32
BETTER_AUTH_SECRET="cambia-esto-por-un-secreto-de-32-caracteres-o-mas"
# URL pública de la app (sin barra final)
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Seed ────────────────────────────────────────────────────────
# Credenciales del administrador que crea `pnpm db:seed`
SEED_ADMIN_EMAIL="admin@gymwarrior.co"
SEED_ADMIN_PASSWORD="Admin12345!"
